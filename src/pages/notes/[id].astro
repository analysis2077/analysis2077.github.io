---
import katex from 'katex';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SecHead from '../../components/SecHead.astro';
import Halo from '../../components/Halo.astro';
import { DISCIPLINES, THEME_META, type Discipline } from '../../data/notes';

// 学科页模板：一门学科对应一本笔记，没有分册层（站主 2026-11-24 修订）——
// 学科有 notebook 时本页即这本笔记的档案（档案卡 + 章节目录 + 文件），否则渲染整理中的空状态。
// 新增学科 / 导入笔记只需在 notes.ts 加数据，本模板自动生成页面。
export function getStaticPaths() {
  return DISCIPLINES.map((d: Discipline) => ({ params: { id: d.id }, props: { d } }));
}
const d: Discipline = Astro.props.d;
const nb = d.notebook;
const meta = THEME_META[d.theme];
const crumbs = [
  { label: '首页', href: '/' },
  { label: '个人笔记', href: '/notes/' },
  { label: d.name },
];
const heroDesc = nb
  ? `${nb.title} —— 这门学科的笔记档案与章节目录。本学科采用 ${meta.desc}学院主题。`
  : `${d.en} —— 本学科采用 ${meta.desc}学院主题。对应笔记整理中，完成后本页即笔记档案与章节目录。`;
const emptyDesc = '这门学科对应的笔记正在整理。完成后本页将直接呈现笔记档案与章节目录'
  + (d.related?.length ? '；相关课程的资料见课程笔记栏目。' : '。');
const formulas = nb?.preview.map((f) => ({ label: f.label, html: katex.renderToString(f.tex) })) ?? [];
---
<Base title={`${d.name} · 个人笔记`}>
  <PageHero theme={d.theme} en={`Discipline · ${d.short}`} zh={d.name} desc={heroDesc} crumbs={crumbs} />
  <div class="wrap">
    {nb ? (
      <>
        <section class="sec">
          <div class:list={['dossier', `th-${d.theme}`]}>
            <div class="dos-strip"><span>Notebook Record</span><span>{nb.series}</span></div>
            <div class="dos-photo">
              <Halo />
              <span class="plate">{meta.plate}</span>
              <span class="art-cap" style="position:static;transform:none;">封面占位 · 等待素材</span>
            </div>
            <div class="dos-info">
              <div class="dos-row"><span class="dos-k">原题名</span><span class="dos-v">{nb.title}</span></div>
              <div class="dos-row"><span class="dos-k">中文简介</span><span class="dos-v">{nb.titleZh} —— {nb.intro}</span></div>
              <div class="dos-row"><span class="dos-k">所属系列</span><span class="dos-v">{nb.series}</span></div>
              <div class="dos-row"><span class="dos-k">语言</span><span class="dos-v">{nb.lang}</span></div>
              <div class="dos-row"><span class="dos-k">先修知识</span><span class="dos-v">{nb.prereq}</span></div>
              <div class="dos-row"><span class="dos-k">适读对象</span><span class="dos-v">{nb.audience}</span></div>
              <div class="dos-row"><span class="dos-k">版本 / 范围</span><span class="dos-v">{nb.version} · 共 {nb.pages} 页</span></div>
              <div class="dos-row"><span class="dos-k">整理状态</span><span class="dos-v"><span class:list={['st', nb.status === '已发布' ? 'st-done' : 'st-wip']}>{nb.status}</span></span></div>
            </div>
          </div>
          <p style="margin-top:18px; display:flex; gap:12px; flex-wrap:wrap;">
            {nb.pdf ? (
              <>
                <a class="btn" href={nb.pdf} target="_blank" rel="noopener">📖 在线阅读 PDF</a>
                <a class="btn btn-ghost" href={nb.pdf} download>⬇ 下载 PDF（{nb.pages} 页）</a>
              </>
            ) : (
              <>
                <button class="btn disabled" disabled>📖 在线阅读（待提供）</button>
                <button class="btn btn-ghost disabled" disabled>⬇ 下载 PDF（待提供）</button>
              </>
            )}
          </p>
        </section>

        <section class="sec" style="padding-top:10px;">
          <SecHead no="01" en="Contents" zh="核心目录" />
          <div class="chap-list">
            {nb.chapters.map((c) => (
              <div class="chap-item">
                <span>{c.name}</span>
                <span class="ci-page">PDF 第 X 页 · {c.page}</span>
              </div>
            ))}
          </div>
          <div class="note-box" style="margin-top:16px;">
            章节目录将先从 PDF 书签 / 目录提取，再由站主核对；<b>英文原题名保留</b>，可加中文说明（规划 §6.3）。
            仅对已提供网页正文的章节生成网页阅读页，其余章节定位到 PDF 文件页并显示可手动查找的页码。
          </div>
        </section>

        <section class="sec">
          <SecHead no="02" en="Math Preview · KaTeX" zh="网页数学环境预览" />
          {formulas.length > 0 && (
            <>
              <div class="grid-2" style="gap:14px;">
                {formulas.slice(0, 2).map((f) => (
                  <div class="formula-box"><span class="fx-label">{f.label}</span><span set:html={f.html} /></div>
                ))}
              </div>
              {formulas.slice(2).map((f) => (
                <div class="formula-box" style="margin-top:14px;"><span class="fx-label">{f.label}</span><span set:html={f.html} /></div>
              ))}
            </>
          )}
          <p style="font-size:12.5px;color:var(--muted);margin-top:10px;">
            网页正文数学排版采用 KaTeX（规划 §12.1）；复杂公式在自身容器内横向滚动，不撑宽页面（规划 §7.2）。
          </p>
        </section>

        <section class="sec">
          <SecHead no="03" en="Related" zh="相关内容" />
          <div class="grid-2">
            {d.related?.map((r) => (
              <a class="cut-card vol-card" href={r.href}>
                <span class="vc-series">{r.kicker}</span>
                <h3>{r.title}</h3>
                <p class="vc-zh">{r.desc}</p>
              </a>
            ))}
            <div class="cut-card vol-card">
              <span class="vc-series">勘误 / 修订记录</span>
              <h3 style="color:var(--muted);">暂无</h3>
              <p class="vc-zh">修订记录将保留日期、版本与主要变化（规划 §9.3）。</p>
            </div>
          </div>
        </section>
      </>
    ) : (
      <section class="sec">
        <div class:list={['empty', `th-${d.theme}`]}>
          <span class="e-star">✦</span>
          <h3>笔记整理中</h3>
          <p>{emptyDesc}</p>
          {!!d.related?.length && (
            <div class="e-cards">
              {d.related.map((r) => (
                <a class="e-card" href={r.href}>{r.kicker} · {r.title} →</a>
              ))}
            </div>
          )}
        </div>
      </section>
    )}
  </div>
</Base>
