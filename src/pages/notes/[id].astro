---
import katex from 'katex';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SecHead from '../../components/SecHead.astro';
import Halo from '../../components/Halo.astro';
import { DISCIPLINES, THEME_META, type Discipline } from '../../data/notes';

// 学科页模板：一门学科对应一本笔记，没有分册层（站主 2026-11-24 修订）——
// 学科有 notebook 时本页即这本笔记的档案（档案卡 + 章节目录 + 文件），否则渲染整理中的空状态。
// 新增学科 / 导入笔记只需在 notes.ts 加数据，本模板自动生成页面。
// 页码口径（与课程页一致）：目录记的是 PDF 页脚的书内页码；链接用 PDF 物理页（书内页码 + offset）定位（规划 §6.3 / §12.1）。
// 档案卡左侧（站主 2026-11-24）：放笔记的封面图（nb.coverImage，Basic PDE 用 PDF 第 7 页），点击打开 PDF。
export function getStaticPaths() {
  return DISCIPLINES.map((d: Discipline) => ({ params: { id: d.id }, props: { d } }));
}
const d: Discipline = Astro.props.d;
const nb = d.notebook;
const meta = THEME_META[d.theme];
const crumbs = [
  { label: '首页', href: '/' },
  { label: '个人笔记', href: '/notes/' },
  { label: d.name },
];
const heroDesc = nb
  ? `${nb.title} —— 这门学科的笔记档案与章节目录。本学科采用 ${meta.desc}学院主题。`
  : `${d.en} —— 本学科采用 ${meta.desc}学院主题。对应笔记整理中，完成后本页即笔记档案与章节目录。`;
const emptyDesc = '这门学科对应的笔记正在整理。完成后本页将直接呈现笔记档案与章节目录'
  + (d.related?.length ? '；相关课程的资料见课程笔记栏目。' : '。');
const formulas = nb?.preview.map((f) => ({ label: f.label, html: katex.renderToString(f.tex) })) ?? [];
const statusClass = { 整理中: 'st-wip', 已发布: 'st-done' };
// 目录链接：书内页码 → PDF 物理页；没有 PDF 时返回 undefined，<a> 不带 href 就不可点击
const pageHref = (page: number) => (nb?.pdf ? `${nb.pdf}#page=${page + nb.offset}` : undefined);
const pdfHref = (pdfPage: number) => (nb?.pdf ? `${nb.pdf}#page=${pdfPage}` : undefined);
const newTab = nb?.pdf ? '_blank' : undefined;
const lastPrinted = nb ? nb.pages - nb.offset : 0;   // 最后一页的书内页码
// 各 Part 的书内页码范围：到下一 Part 起始页的前一页为止
const rangeOf = (page: number, i: number) => {
  const end = (i + 1 < nb!.parts.length ? nb!.parts[i + 1].page : lastPrinted + 1) - 1;
  return `${page}–${end}`;
};
const coverHref = nb?.pdf && nb.coverPage ? `${nb.pdf}#page=${nb.coverPage}` : nb?.pdf;
---

<Base title={`${d.name} · 个人笔记`}>
  <PageHero theme={d.theme} en={`Discipline · ${d.short}`} zh={d.name} desc={heroDesc} crumbs={crumbs} />
  <div class="wrap">
    {nb ? (
      <>
        <section class="sec">
          <div class:list={['dossier', `th-${d.theme}`]}>
            <div class="dos-strip"><span>Notebook Record</span><span>{nb.series}</span></div>
            <div class="dos-photo">
              {nb.coverImage ? (
                <a href={coverHref} target="_blank" rel="noopener" title="打开 PDF">
                  <img
                    class="dos-cover" src={nb.coverImage}
                    alt={`${nb.title} 笔记封面（PDF 第 ${nb.coverPage} 页）`}
                    width={nb.coverSize?.[0]} height={nb.coverSize?.[1]}
                  />
                </a>
              ) : (
                <>
                  <Halo />
                  <span class="plate">{meta.plate}</span>
                  <span class="art-cap" style="position:static;transform:none;">封面占位 · 等待素材</span>
                </>
              )}
              {nb.coverImage && <span class="dos-cap">封面 · PDF 第 {nb.coverPage} 页 · 点击打开</span>}
            </div>
            <div class="dos-info">
              <div class="dos-row"><span class="dos-k">原题名</span><span class="dos-v">{nb.title}</span></div>
              <div class="dos-row"><span class="dos-k">中文简介</span><span class="dos-v">{nb.titleZh} —— {nb.intro}</span></div>
              <div class="dos-row"><span class="dos-k">所属系列</span><span class="dos-v">{nb.series}</span></div>
              <div class="dos-row"><span class="dos-k">语言</span><span class="dos-v">{nb.lang}</span></div>
              <div class="dos-row"><span class="dos-k">先修知识</span><span class="dos-v">{nb.prereq}</span></div>
              <div class="dos-row"><span class="dos-k">适读对象</span><span class="dos-v">{nb.audience}</span></div>
              <div class="dos-row"><span class="dos-k">版本 / 范围</span><span class="dos-v">{nb.version}{nb.scope && ` · ${nb.scope}`} · 共 {nb.pages} 页</span></div>
              <div class="dos-row"><span class="dos-k">整理状态</span><span class="dos-v"><span class:list={['st', statusClass[nb.status]]}>{nb.status}</span></span></div>
            </div>
          </div>
          <p class="dos-note">笔记版本取自 PDF 封面所载的修订日期；PDF 共 {nb.pages} 页，前 {nb.offset} 页是封面与前置页，其余页面按书内页码编排。</p>
          <p style="margin-top:14px; display:flex; gap:12px; flex-wrap:wrap;">
            {nb.pdf ? (
              <>
                <a class="btn" href={nb.pdf} target="_blank" rel="noopener">📖 在线阅读 PDF</a>
                <a class="btn btn-ghost" href={nb.pdf} download>⬇ 下载 PDF（{nb.pages} 页{nb.size && ` · ${nb.size}`}）</a>
              </>
            ) : (
              <>
                <button class="btn disabled" disabled>📖 在线阅读（待提供）</button>
                <button class="btn btn-ghost disabled" disabled>⬇ 下载 PDF（待提供）</button>
              </>
            )}
          </p>
        </section>

        <section class="sec" style="padding-top:10px;">
          <SecHead no="01" en="Contents" zh="核心目录" />
          <div class="toc">
            {nb.front?.map((f) => (
              <div class="toc-ch">
                <div class="toc-head">
                  <span class="toc-no"></span>
                  <a class="toc-title" href={pdfHref(f.pdfPage)} target={newTab} rel="noopener">{f.title}</a>
                  {f.zh && <span class="toc-zh">{f.zh}</span>}
                  <a class="toc-pg" href={pdfHref(f.pdfPage)} target={newTab} rel="noopener">PDF 第 {f.pdfPage} 页 ↗</a>
                </div>
              </div>
            ))}
            {nb.parts.map((p, i) => (
              <div class="toc-part">
                <p class="toc-meta">
                  {p.no && `Part ${p.no} · `}{p.title}{p.zh && ` · ${p.zh}`}
                  {' · 书内第 '}{rangeOf(p.page, i)} 页 · {p.chapters.length} 章{p.chapters.reduce((a, c) => a + c.sections.length, 0)} 节
                </p>
                {p.chapters.map((ch) => (
                  <div class="toc-ch">
                    <div class="toc-head">
                      <span class="toc-no">{ch.no}</span>
                      <a class="toc-title" href={pageHref(ch.page)} target={newTab} rel="noopener">{ch.title}</a>
                      {ch.zh && <span class="toc-zh">{ch.zh}</span>}
                      <a class="toc-pg" href={pageHref(ch.page)} target={newTab} rel="noopener">p. {ch.page} ↗</a>
                    </div>
                    {ch.sections.length > 0 && (
                      <div class="toc-secs">
                        {ch.sections.map((s) => (
                          <a class="toc-sec" href={pageHref(s.page)} target={newTab} rel="noopener">
                            <span class="ts-no">{s.no}</span>{s.title}{s.zh && <span class="ts-zh">{s.zh}</span>}<span class="ts-pg">p. {s.page}</span>
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            ))}
          </div>
          <div class="note-box" style="margin-top:16px;">
            目录里的页码是 PDF 页脚标注的<b>书内页码</b>；点击条目会在新标签页打开 PDF 并跳到对应页
            （PDF 阅读器里显示的页码 = 书内页码 + {nb.offset}）。英文原题名保留，旁附的中文说明为站内译名。
          </div>
        </section>

        <section class="sec">
          <SecHead no="02" en="Math Preview · KaTeX" zh="网页数学环境预览" />
          {formulas.length > 0 && (
            <>
              <div class="grid-2" style="gap:14px;">
                {formulas.slice(0, 2).map((f) => (
                  <div class="formula-box"><span class="fx-label">{f.label}</span><span set:html={f.html} /></div>
                ))}
              </div>
              {formulas.slice(2).map((f) => (
                <div class="formula-box" style="margin-top:14px;"><span class="fx-label">{f.label}</span><span set:html={f.html} /></div>
              ))}
            </>
          )}
          <p style="font-size:12.5px;color:var(--muted);margin-top:10px;">
            网页正文数学排版采用 KaTeX（规划 §12.1）；复杂公式在自身容器内横向滚动，不撑宽页面（规划 §7.2）。
          </p>
        </section>

        <section class="sec">
          <SecHead no="03" en="Related" zh="相关内容" />
          <div class="grid-2">
            {d.related?.map((r) => (
              <a class="cut-card vol-card" href={r.href}>
                <span class="vc-series">{r.kicker}</span>
                <h3>{r.title}</h3>
                <p class="vc-zh">{r.desc}</p>
              </a>
            ))}
            <div class="cut-card vol-card">
              <span class="vc-series">勘误 / 修订记录</span>
              <h3 style="color:var(--muted);">暂无</h3>
              <p class="vc-zh">修订记录将保留日期、版本与主要变化（规划 §9.3）。</p>
            </div>
          </div>
        </section>
      </>
    ) : (
      <section class="sec">
        <div class:list={['empty', `th-${d.theme}`]}>
          <span class="e-star">✦</span>
          <h3>笔记整理中</h3>
          <p>{emptyDesc}</p>
          {!!d.related?.length && (
            <div class="e-cards">
              {d.related.map((r) => (
                <a class="e-card" href={r.href}>{r.kicker} · {r.title} →</a>
              ))}
            </div>
          )}
        </div>
      </section>
    )}
  </div>
</Base>
