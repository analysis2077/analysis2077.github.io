---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
---
<Base title="数学分析 · 个人笔记">
  <PageHero
    theme="millennium"
    en="Discipline · Mathematical Analysis"
    zh="数学分析"
    desc="Mathematical Analysis —— 本学科采用 Millennium 蓝紫学院主题。专题与分册整理中，首批条目导入后将在此列出。"
    crumbs={[{ label: '首页', href: '/' }, { label: '个人笔记', href: '/notes/' }, { label: '数学分析' }]}
  />
  <div class="wrap">
    <section class="sec">
      <div class="empty th-millennium">
        <span class="e-star">✦</span>
        <h3>分册整理中</h3>
        <p>本学科的专题 / 分册正在整理。完成后将按「学科 → 专题 / 分册 → 章节」在此列出，
        相关课程（如 MTH118 · Analysis II）的资料见课程笔记栏目。</p>
        <div class="e-cards">
          <a class="e-card" href="/courses/mth118/">相关课程 · MTH118 Analysis II →</a>
        </div>
      </div>
    </section>
  </div>
</Base>
