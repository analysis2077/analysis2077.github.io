---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
---
<Base title="测度与积分 · 个人笔记">
  <PageHero
    theme="abydos"
    en="Discipline · Measure & Integration"
    zh="测度与积分"
    desc="Measure & Integration —— 本学科采用 Abydos 沙金学院主题。专题与分册整理中，首批条目导入后将在此列出。"
    crumbs={[{ label: '首页', href: '/' }, { label: '个人笔记', href: '/notes/' }, { label: '测度与积分' }]}
  />
  <div class="wrap">
    <section class="sec">
      <div class="empty th-abydos">
        <span class="e-star">✦</span>
        <h3>分册整理中</h3>
        <p>本学科的专题 / 分册正在整理。完成后将按「学科 → 专题 / 分册 → 章节」在此列出。</p>
      </div>
    </section>
  </div>
</Base>
