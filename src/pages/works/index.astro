---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SecHead from '../../components/SecHead.astro';
---
<Base title="作品">
  <PageHero
    theme="trinity"
    en="Works"
    zh="作品"
    desc="按模板、代码、排版工具等类型组织。作品页展示用途、示例图、编译环境、用法、当前版本与下载入口（规划 §8.4）。"
    crumbs={[{ label: '首页', href: '/' }, { label: '作品' }]}
  />
  <div class="wrap">
    <section class="sec">
      <SecHead no="01" en="Templates" zh="模板 / 排版工具" />
      <div class="dossier th-gehenna" style="grid-template-columns:230px 1fr;">
        <div class="dos-strip"><span>Work Record</span><span>V1.2.0</span></div>
        <div class="dos-photo">
          <svg viewBox="0 0 120 52" width="92" height="40" aria-hidden="true">
            <ellipse cx="60" cy="26" rx="54" ry="19" fill="none" stroke="#C8404A" stroke-width="4.5"/>
            <ellipse cx="60" cy="26" rx="54" ry="19" fill="none" stroke="#FBF0F0" stroke-width="1.5" transform="translate(0,-2.5)"/>
          </svg>
          <span class="plate" style="color:#8E2F38;border-color:#C8404A;">BA MATH</span>
          <span class="art-cap" style="position:static;transform:none;">示例图占位</span>
        </div>
        <div class="dos-info">
          <div class="dos-row"><span class="dos-k">名称</span><span class="dos-v">BlueArchiveMathBook <span class="tag th-gehenna">LaTeX 模板</span></span></div>
          <div class="dos-row"><span class="dos-k">用途</span><span class="dos-v">二次元（Blue Archive）风格的数学笔记 / 讲义排版：七学院主题、章节横幅、角色档案、阅读路线与数学环境。</span></div>
          <div class="dos-row"><span class="dos-k">当前版本</span><span class="dos-v">v1.2.0（站主已提供样本 zip，待导入）</span></div>
          <div class="dos-row"><span class="dos-k">编译环境</span><span class="dos-v">LaTeX（导入后补充具体发行版与编译方式）</span></div>
          <div class="dos-row"><span class="dos-k">下载</span><span class="dos-v muted">待提供 —— 导入后显示带版本号的下载入口</span></div>
        </div>
      </div>
    </section>
    <section class="sec">
      <SecHead no="02" en="More" zh="更多作品" />
      <div class="empty">
        <span class="e-star">✦</span>
        <h3>待补充</h3>
        <p>普通小作品一张详情页即可；说明足够多时才拆出使用文档或版本页。旧版本会保留可追溯入口，下载显示版本号。</p>
      </div>
    </section>
  </div>
</Base>
