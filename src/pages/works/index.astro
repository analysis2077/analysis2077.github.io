---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SecHead from '../../components/SecHead.astro';

// 统一的系列卡片入口：详情都在各自详情页，目录页保持简洁同款（站主 2026-11-23 拍板）
const SERIES = [
  {
    no: 'A',
    en: 'Blue Archive',
    zh: 'BA 数学书模板',
    items: [
      {
        href: '/works/ba-math-book/',
        cover: '/works/ba-math-book/demo-cover.jpg',
        alt: 'BlueArchiveMathBook 演示书封面',
        tags: ['LaTeX 模板', '书籍模板'],
        name: 'BlueArchiveMathBook',
        desc: '二次元（Blue Archive）风格的数学书排版：七学院主题、章节横幅、角色档案、阅读路线与数学环境；本站视觉配色来源。',
        ver: 'v1.2.1 · 2026-11-23',
      },
    ],
  },
  {
    no: 'B',
    en: 'RA Series',
    zh: 'RA 系列模板（同一 ra-common.sty 家族）',
    items: [
      {
        href: '/works/ra-handout/',
        cover: '/works/ra-handout/demo-masthead.jpg',
        alt: 'RA Handout 演示报头',
        tags: ['LaTeX 模板', '周讲义'],
        name: 'RA Handout Template',
        desc: '研究助理每周讲义：报头式首页、按节编号定理盒、三色分工、natbib 引文，XeLaTeX 一键构建。',
        ver: 'v1.0.0 · 2026-09-30',
      },
      {
        href: '/works/ra-report/',
        cover: '/works/ra-report/demo-title.jpg',
        alt: 'RA Report 演示扉页',
        tags: ['LaTeX 模板', '结题报告'],
        name: 'RA Report Template',
        desc: '研究助理结题报告：book 类多章骨架、扉页元信息栏、按章编号，与周讲义共享同一套视觉与引文体系。',
        ver: 'v1.0.0 · 2026-09-30',
      },
    ],
  },
  {
    no: 'C',
    en: 'Course Notes',
    zh: '学校课程笔记模板',
    items: [
      {
        href: '/works/school-course-notes/',
        cover: '/works/school-course-notes/demo-title.jpg',
        alt: 'School Course Notes 样书扉页',
        tags: ['LaTeX 模板', '合订文档'],
        name: 'School Course Notes Template',
        desc: '一门课一份：知识笔记 / TTL 材料 / 往年试题三部分合订，学生版可整体隐藏解答——本站课程栏目的三类资料划分即来源于此。',
        ver: 'v1.0.1 · 2026-07-15',
      },
    ],
  },
];
---
<Base title="作品">
  <PageHero
    theme="trinity"
    en="Works"
    zh="作品"
    desc="按模板、代码、排版工具等类型组织。作品页展示用途、示例图、编译环境、用法、当前版本与下载入口（规划 §8.4）。"
    crumbs={[{ label: '首页', href: '/' }, { label: '作品' }]}
  />
  <div class="wrap">
    <section class="sec">
      <SecHead no="01" en="Templates" zh="模板 / 排版工具" />
      {SERIES.map((s) => (
        <Fragment>
          <div class:list={['series-head', s.no === 'A' && 'sh-first']}>
            <span class="series-no">{s.no}</span>
            <div class="sh-t">
              <p class="sh-en">{s.en}</p>
              <h3>{s.zh}</h3>
            </div>
            <span class="sec-line"></span>
          </div>
          <div class="grid-2">
            {s.items.map((it) => (
              <a class="cut-card work-item" href={it.href}>
                <img class="wi-cover" src={it.cover} alt={it.alt} loading="lazy" />
                <span class="wi-body">
                  <span class="wi-meta">
                    {it.tags.map((t) => <span class="tag">{t}</span>)}
                  </span>
                  <h3>{it.name}</h3>
                  <p>{it.desc}</p>
                  <span class="wi-ver">{it.ver}</span>
                  <span class="wi-go">查看详情 →</span>
                </span>
              </a>
            ))}
          </div>
        </Fragment>
      ))}
    </section>
    <section class="sec">
      <SecHead no="02" en="More" zh="更多作品" />
      <div class="empty">
        <span class="e-star">✦</span>
        <h3>待补充</h3>
        <p>普通小作品一张详情页即可；说明足够多时才拆出使用文档或版本页。旧版本会保留可追溯入口，下载显示版本号。</p>
      </div>
    </section>
  </div>
</Base>
