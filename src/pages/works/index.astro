---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SecHead from '../../components/SecHead.astro';
---
<Base title="作品">
  <PageHero
    theme="trinity"
    en="Works"
    zh="作品"
    desc="按模板、代码、排版工具等类型组织。作品页展示用途、示例图、编译环境、用法、当前版本与下载入口（规划 §8.4）。"
    crumbs={[{ label: '首页', href: '/' }, { label: '作品' }]}
  />
  <div class="wrap">
    <section class="sec">
      <SecHead no="01" en="Templates" zh="模板 / 排版工具" />
      <div class="dossier">
        <div class="dos-strip"><span>Work Record</span><span>v1.2.1 · 2026-11-23</span></div>
        <div class="dos-photo">
          <img
            src="/works/ba-math-book/demo-cover.jpg"
            alt="BlueArchiveMathBook v1.2.1 演示书封面"
            style="width:100%;aspect-ratio:1/1.414;object-fit:cover;border:2px solid var(--sky);border-radius:12px;"
          />
          <span class="plate">BA MATH BOOK</span>
        </div>
        <div class="dos-info">
          <div class="dos-row"><span class="dos-k">名称</span><span class="dos-v"><a href="/works/ba-math-book/"><b>BlueArchiveMathBook</b></a> <span class="tag">LaTeX 模板</span></span></div>
          <div class="dos-row"><span class="dos-k">用途</span><span class="dos-v">二次元（Blue Archive）风格的数学笔记 / 讲义排版：七学院主题、章节横幅、角色档案、阅读路线与数学环境；本站视觉配色亦源自此模板。</span></div>
          <div class="dos-row"><span class="dos-k">当前版本</span><span class="dos-v">v1.2.1（2026-11-23）</span></div>
          <div class="dos-row"><span class="dos-k">编译环境</span><span class="dos-v">XeLaTeX · latexmk 多轮编译</span></div>
          <div class="dos-row"><span class="dos-k">下载</span><span class="dos-v muted">整理中 —— 发布入口待定</span></div>
        </div>
      </div>
      <p style="margin-top:16px;">
        <a class="btn btn-sm" href="/works/ba-math-book/">查看作品详情 →</a>
      </p>
    </section>
    <section class="sec">
      <SecHead no="02" en="More" zh="更多作品" />
      <div class="empty">
        <span class="e-star">✦</span>
        <h3>待补充</h3>
        <p>普通小作品一张详情页即可；说明足够多时才拆出使用文档或版本页。旧版本会保留可追溯入口，下载显示版本号。</p>
      </div>
    </section>
  </div>
</Base>
