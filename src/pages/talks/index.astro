---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SecHead from '../../components/SecHead.astro';
---
<Base title="讲课与讨论班">
  <PageHero
    en="Talks & Seminars"
    zh="讲课与讨论班"
    desc="视频存放于 B 站或其他平台，本站保存外链与配套资料。单次讲课建立活动条目；讨论班建立系列页，按场次排列（规划 §8.3）。"
    crumbs={[{ label: '首页', href: '/' }, { label: '讲课与讨论班' }]}
  />
  <div class="wrap">
    <section class="sec">
      <SecHead no="01" en="Structure" zh="层级结构" />
      <table class="tbl">
        <thead>
          <tr><th>层级</th><th>必要信息</th><th>可增加的信息</th></tr>
        </thead>
        <tbody>
          <tr><td><b>单次讲课</b></td><td>标题、简介、平台与链接</td><td>日期、讲义、幻灯片、相关笔记</td></tr>
          <tr><td><b>讨论班系列</b></td><td>系列名、主题、场次目录</td><td>先修知识、学习目标、参考书</td></tr>
          <tr><td><b>一次场次</b></td><td>场次标题、视频或「待上传」状态</td><td>分段链接、讲者、讲义和笔记</td></tr>
        </tbody>
      </table>
    </section>

    <section class="sec">
      <SecHead no="02" en="Entries" zh="活动条目" />
      <div class="grid-2">
        <div class="empty">
          <span class="e-star">✦</span>
          <h3>暂无单次讲课</h3>
          <p>提供「标题 + 平台 + 链接」即可建立第一个活动条目；没有真实链接时明确标注「待上传」。</p>
        </div>
        <div class="empty">
          <span class="e-star">✦</span>
          <h3>暂无讨论班系列</h3>
          <p>讨论班按系列组织，同一场次允许多个平台或分段链接；首版用「在 B 站观看」等按钮跳转。</p>
        </div>
      </div>
    </section>
  </div>
</Base>
