---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import SecHead from '../../../components/SecHead.astro';

const knowledge = [
  { name: 'Continuity 连续性', meta: '合并 PDF · 文件第 7 页（示例定位）', pending: true },
  { name: '其余知识章节目录', meta: 'PDF 书签提取后由站主核对 · 规划 §6.3', pending: true },
];
const ttl = [1, 2, 3, 4, 5, 6].map((n) => ({ name: `TTL ${n}`, meta: '题目 / 题解 / 补充题', pending: true }));
const papers = [
  { name: '往年试题 A（考试学年待核对）', meta: '题目 + 解答', pending: true },
  { name: '往年试题 B（考试学年待核对）', meta: '题目 + 解答', pending: true },
  { name: '往年试题 C（考试学年待核对）', meta: '题目 + 解答', pending: true },
];
---
<Base title="MTH118 · Analysis II">
  <PageHero
    en="Course File"
    zh="MTH118 · Analysis II"
    desc="本科 · 分析 · 2023–2024 Semester 2 —— 首个真实样本课程，248 页合并 PDF 待导入。"
    crumbs={[{ label: '首页', href: '/' }, { label: '课程笔记', href: '/courses/' }, { label: 'MTH118' }]}
  />
  <div class="wrap">
    <section class="sec">
      <div class="dossier">
        <div class="dos-strip"><span>Course Record · MTH118</span><span>2023–2024 S2</span></div>
        <div class="dos-photo">
          <svg viewBox="0 0 120 52" width="92" height="40" aria-hidden="true">
            <ellipse cx="60" cy="26" rx="54" ry="19" fill="none" stroke="#4CB3FF" stroke-width="4.5"/>
            <ellipse cx="60" cy="26" rx="54" ry="19" fill="none" stroke="#EAF7FF" stroke-width="1.5" transform="translate(0,-2.5)"/>
          </svg>
          <span class="plate">MTH118</span>
          <span class="art-cap" style="position:static;transform:none;">课程徽记占位</span>
        </div>
        <div class="dos-info">
          <div class="dos-row"><span class="dos-k">课程代码</span><span class="dos-v">MTH118</span></div>
          <div class="dos-row"><span class="dos-k">原题名</span><span class="dos-v">Analysis II（分析 II）</span></div>
          <div class="dos-row"><span class="dos-k">学段 / 主题</span><span class="dos-v">本科 · 分析</span></div>
          <div class="dos-row"><span class="dos-k">学年学期</span><span class="dos-v">2025–2026 · Semester 2</span></div>
          <div class="dos-row"><span class="dos-k">资料范围</span><span class="dos-v">知识笔记 · TTL × 6 · 往年试题 × 3（同一份 248 页合并 PDF）</span></div>
          <div class="dos-row"><span class="dos-k">整理状态</span><span class="dos-v"><span class="st st-wip">整理中</span></span></div>
        </div>
      </div>
      <p style="margin-top:18px;">
        <button class="btn disabled" disabled>⬇ 整本 PDF 阅读 / 下载 · 248 页（文件待提供）</button>
      </p>
    </section>

    <section class="sec" style="padding-top:8px;">
      <SecHead no="01" en="Knowledge Notes" zh="知识笔记" />
      <div class="doc-list">
        <details open>
          <summary>章节目录 <span class="sm-en">KNOWLEDGE NOTES</span></summary>
          {knowledge.map((k) => (
            <div class="file-row">
              <span class="fr-name">{k.name}</span>
              <span class="fr-meta">{k.meta}</span>
              <span class="fr-act"><span class="fr-pending">待导入</span></span>
            </div>
          ))}
        </details>
      </div>
    </section>

    <section class="sec">
      <SecHead no="02" en="TTL Materials" zh="TTL / 习题材料" />
      <div class="doc-list">
        <details>
          <summary>按场次列出 <span class="sm-en">TTL × 6</span></summary>
          {ttl.map((t) => (
            <div class="file-row">
              <span class="fr-name">{t.name}</span>
              <span class="fr-meta">{t.meta}</span>
              <span class="fr-act"><span class="fr-pending">待导入</span></span>
            </div>
          ))}
        </details>
      </div>
    </section>

    <section class="sec">
      <SecHead no="03" en="Past Papers" zh="往年试题" />
      <div class="doc-list">
        <details>
          <summary>按考试学年组织 <span class="sm-en">PAST PAPERS × 3</span></summary>
          {papers.map((p) => (
            <div class="file-row">
              <span class="fr-name">{p.name}</span>
              <span class="fr-meta">{p.meta}</span>
              <span class="fr-act"><span class="fr-pending">待导入</span></span>
            </div>
          ))}
        </details>
      </div>
    </section>

    <section class="sec">
      <SecHead no="04" en="Related" zh="相关内容" />
      <div class="grid-2">
        <a class="cut-card vol-card" href="/notes/pde/basic-pde/">
          <span class="vc-series">相关个人笔记</span>
          <h3>Basic Partial Differential Equations</h3>
          <p class="vc-zh">偏微分方程基础 · The Unfinished Way · Part I</p>
        </a>
        <div class="cut-card vol-card">
          <span class="vc-series">参考资料 / 视频</span>
          <h3 style="color:var(--muted);">待整理</h3>
          <p class="vc-zh">相关讨论班、录像与参考书将在导入后关联。</p>
        </div>
      </div>
      <div class="note-box" style="margin-top:18px;">
        <b>迁移方式（规划 §4.3）：</b>248 页 PDF 先保留整体下载；知识笔记、6 次 TTL 和 3 份往年试题的网页目录
        引用同一文件内相应位置。PDF 文件页码与书内页码分别记录（例：文件第 7 页对应连续性章节）。
      </div>
    </section>
  </div>
</Base>
