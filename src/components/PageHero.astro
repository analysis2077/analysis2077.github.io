---
import Breadcrumb from './Breadcrumb.astro';
// 子页面顶部横幅；theme 为学院主题类名（对应 global.css 的 .page-hero.th-* 变体）
type Theme = '' | 'gehenna' | 'trinity' | 'millennium' | 'abydos' | 'shanhaijing' | 'hyakkiyako' | 'schale';
interface Props {
  en: string;
  zh: string;
  desc?: string;
  crumbs: { label: string; href?: string }[];
  theme?: Theme;
}
const { en, zh, desc, crumbs, theme = '' } = Astro.props;
---
<section class:list={['page-hero', theme && `th-${theme}`]}>
  <div class="wrap">
    <Breadcrumb items={crumbs} />
    <p class="ph-en">{en}</p>
    <h1>{zh}</h1>
    {desc && <p class="ph-desc">{desc}</p>}
  </div>
</section>
